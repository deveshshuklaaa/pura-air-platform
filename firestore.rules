rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /devices/{deviceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Device registry (readable for validation) + single-owner claim.
    match /devices/{deviceId} {
      allow read: if request.auth != null;
      allow create: if false;
      allow update: if request.auth != null
        && resource.data.owner_uid == null
        && request.resource.data.owner_uid == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['owner_uid']);
      allow delete: if false;
    }

    // Pairing codes (sharing only).
    match /pairing_codes/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.owner_uid == request.auth.uid
        && exists(/databases/$(database)/documents/devices/$(request.resource.data.device_id))
        && get(/databases/$(database)/documents/devices/$(request.resource.data.device_id)).data.owner_uid
           == request.auth.uid;
      allow delete: if request.auth != null;
    }
  }
}
