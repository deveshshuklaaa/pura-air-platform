rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function account() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function member(deviceId) {
      let device = get(/databases/$(database)/documents/devices/$(deviceId)).data;
      return account() && device.active == true && device.members[request.auth.uid] in ['owner', 'shared'];
    }
    function profile() {
      let p = request.resource.data;
      return p.keys().hasOnly(['display_name', 'phone', 'location', 'about'])
        && (!('display_name' in p) || (p.display_name is string && p.display_name.size() <= 100))
        && (!('phone' in p) || (p.phone is string && p.phone.size() <= 30))
        && (!('location' in p) || (p.location is string && p.location.size() <= 200))
        && (!('about' in p) || (p.about is string && p.about.size() <= 1000));
    }
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && profile();
      allow delete: if request.auth != null && request.auth.uid == uid;
      match /devices/{deviceId} {
        // Backend-written display mirrors are never an authorization source.
        allow read: if account() && request.auth.uid == uid;
        allow write: if false;
      }
    }
    match /devices/{deviceId} {
      allow read, write: if false;
      match /history/{recordId} {
        allow read: if member(deviceId);
        allow write: if false;
      }
    }
    // Registry, credentials, pairing hashes and rate limits are server-only.
    match /{document=**} { allow read, write: if false; }
  }
}
